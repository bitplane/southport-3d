    {
      "id": "surfaces",
      "match": "^(Surface|Kerb|Pattern|Marking|Tactile|Cover) ",
      "walk": {
        "strategy": "keep",
        "reason": "Already coarse surfaces; preserve kerb silhouette and large paving motifs. Tile joints live in shared authored maps."
      },
      "district": {
        "strategy": "keep",
        "reason": "Retain ground continuity and recognisable paving/road pattern; reduce map resolution rather than collapse the outline."
      }
    },
    {
      "id": "chains",
      "match": "^Chain ",
      "walk": {
        "strategy": "keep",
        "reason": "Low-sided sagging cable retains the barrier line without individual links."
      },
      "district": {
