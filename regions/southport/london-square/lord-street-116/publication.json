    },
    {
      "id": "windows",
      "match": "^Window ",
      "walk": {
        "strategy": "keep",
        "reason": "Retain slim window divisions and spandrel depth in the repeated inexpensive module."
      },
      "district": {
        "strategy": "replace",
        "reason": "Replace each repeated window/spandrel module with one shared baked panel; white surround remains physical.",
